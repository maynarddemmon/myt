{
    "name": "myt",
    "version": "1.0.1",
    "author": "Maynard Demmon",
    "description": "The myt UI framework.",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "eslint": "^8.57.1",
        "globals": "^16.5.0",
        "google-closure-compiler": "^20230802.0.0",
        "google-closure-compiler-osx": "^20240317.0.0",
        "jsdom": "^26.0.0"
    },
    "scripts": {
        "build-loader": "./bin/build bin/loader-browser-manifest.js dist/loader-browser.js ./src true true JS && rm ./dist/loader-browser.js",
        "build-expressionParser": "node ./src/js/expression_parser/build.js ./src/js/expression_parser/grammar false",
        "build-myt": "./bin/build src/js/myt/manifest.js dist/myt.js ./src true true myt.all",
        "build-tym": "./bin/build src/js/tym/manifest.js dist/tym.js ./src true true tym.all",
        "lint": "eslint src",
        "test": "node ./bin/run-tests.js",
        "test-all": "node ./bin/run-tests.js --all",
        "buildAndTest-myt": "npm run build-myt && npm test && npm run lint",
        "buildAndTest-expressionParser": "node ./src/js/expression_parser/build.js ./src/js/expression_parser/grammar true",
        "enchilada": "npm run build-loader && npm run buildAndTest-expressionParser && npm run build-tym && npm run buildAndTest-myt"
    }
}
